---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import QuestionCard from '../../components/QuestionCard.astro';
import { catalog, href, formatDate, tagLabel } from '../../lib/catalog';
export async function getStaticPaths() { return (await catalog()).all.map(post => ({ params: { id: post.data.id }, props: { post } })); }
const { post } = Astro.props;
const { Content } = await render(post);
const { active, real } = await catalog();
const related = active.filter(other => other.data.id !== post.data.id && other.data.tags.some((tag: string) => post.data.tags.includes(tag))).slice(0, 3);
const source = { codex: 'Codex', 'chatgpt-work': 'ChatGPT Work', import: '导入记录' }[post.data.source];
---
<Layout title={post.data.title} description={post.data.question}><a class="back-link" href={href()}>← 回到提问记录</a><div class="article-layout"><article data-pagefind-body data-pagefind-ignore={post.data.demo && real.length > 0 ? true : undefined}><header class="article-header"><div class="card-meta"><span class="source-dot"></span><span>{source}</span><time datetime={post.data.createdAt}>{formatDate(post.data.createdAt, true)}</time>{post.data.demo && <span class="demo-label">示例题 · 非真实提问</span>}</div><h1 data-pagefind-meta="title">{post.data.title}</h1><div class="tag-list">{post.data.tags.map((tag: string) => <a class="tag" href={href(`tags/${tag}/`)} data-pagefind-filter="tag">{tagLabel(tag)}</a>)}</div></header><section class="original-question"><p class="eyebrow">THE QUESTION</p><p>{post.data.question}</p></section><section class="answer-section"><p class="eyebrow answer-label">THE ANSWER & FOLLOW-UPS</p><div class="prose"><Content /></div></section><div class="article-end" data-pagefind-ignore><Icon name="check" size={18} /><p>读到这里，试着关掉答案，用自己的话解释一遍。</p><a class="text-link small" href={href(`review/?id=${post.data.id}`)}>回忆这道题 <Icon name="arrow" size={15} /></a></div></article><aside class="article-aside" data-pagefind-ignore><div class="sticky-aside"><p class="eyebrow">QUESTION NOTES</p><dl><dt>首次提问</dt><dd>{formatDate(post.data.createdAt, true)}</dd><dt>最近追问 / 更新</dt><dd>{formatDate(post.data.updatedAt, true)}</dd><dt>回答来源</dt><dd>{source}</dd></dl><a class="button primary" href={href(`review/?id=${post.data.id}`)}>试着回忆 <Icon name="repeat" size={16} /></a><p>你的掌握程度仅保存在当前浏览器，不会发布到 GitHub。</p><a class="text-link small" href={`https://github.com/WenHuaCao/interview-notes/blob/main/content/${post.data.demo ? 'examples' : `questions/${new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Shanghai', year: 'numeric' }).format(new Date(post.data.createdAt))}/${new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Shanghai', month: '2-digit' }).format(new Date(post.data.createdAt))}`}/${post.data.id}.md`} target="_blank" rel="noopener noreferrer">查看原始记录 ↗</a></div></aside></div>{related.length > 0 && <section class="related-section" data-pagefind-ignore><div class="section-heading"><h2>沿着这个问题，再走一步</h2><span class="eyebrow">RELATED QUESTIONS</span></div><div class="related-grid">{related.map(other => <QuestionCard post={other} />)}</div></section>}</Layout>
