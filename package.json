{
  "name": "interview-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "validate": "node scripts/journal.mjs validate",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "build": "npm run validate && astro build && pagefind --site dist",
    "preview": "astro preview --host 127.0.0.1",
    "journal": "node scripts/journal.mjs"
  },
  "dependencies": {
    "astro": "^5.16.0",
    "gray-matter": "^4.0.3",
    "rehype-sanitize": "^6.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^24.0.0",
    "@playwright/test": "^1.56.1",
    "pagefind": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
